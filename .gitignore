# Responsive variants produced by jekyll-imagemagick on every build.
# Committing them makes Jekyll copy them AND imagemagick regenerate them,
# which collides on the same destination path.
assets/img/**/*-480.webp
assets/img/**/*-800.webp
assets/img/**/*-1400.webp

